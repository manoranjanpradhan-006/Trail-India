# Trail India Environment Configuration

# Application
APP_ENV=development
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Database configuration
# Leave blank to automatically use pure embedded SQLite (no setup needed)
# Or specify PostgreSQL connection string:
# DATABASE_URL=postgres://trail_user:trail_password@localhost:5432/trail_india?sslmode=disable
DATABASE_URL=

# PostgreSQL Docker credentials
POSTGRES_USER=trail_user
POSTGRES_PASSWORD=trail_password
POSTGRES_DB=trail_india
POSTGRES_PORT=5432

# Security & Sessions
JWT_SECRET=trail_india_super_secure_secret_key_2026_dev
