PORT=8080
NODE_ENV=development
JWT_SECRET=trail-india-secret-key-super-secure-token-2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Neon PostgreSQL Connection URL
# Get this from your Neon Console (https://console.neon.tech) -> Connection Details
# Example format:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sparkling-wave-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Fallback SQLite path (used only if DATABASE_URL is empty)
DATABASE_PATH=./trail_india.db
